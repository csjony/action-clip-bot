# =============================================================================
# Action Clip Bot — environment variables.
# Copy this file to `.env` and fill in your keys. NEVER commit the real `.env`.
#
# CREDIT-CARD-FREE BY DEFAULT:
#   Every key in section [A] is obtainable WITHOUT a credit card.
#   Section [B] keys are OPTIONAL — they unlock paid/fal.ai providers and
#   require a credit card. Leave them blank for the free bootstrap path.
# =============================================================================

# =============================================================================
# [A] REQUIRED / FREE / NO CREDIT CARD — set these to run the bot
# =============================================================================

# --- LLM (scriptwriting) — Google Gemini free tier, no CC -------------------
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Alternative: Groq free tier (fill one of the two)
GROQ_API_KEY=

# --- Video-generation provider (Local / RunPod / Cloud GPU VPS) -------------
# The public API URL of your local/GPU server running Wan 2.2
# Example: https://some-random-id.loca.lt or http://localhost:8000
LOCAL_GENERATOR_URL=

# --- Music (royalty-free) — Jamendo, free account, no CC --------------------
# https://developer.jamendo.com/v3.0
JAMENDO_CLIENT_ID=

# --- Social publishing — aggregator (primary, free tier) --------------------
# Pick ONE aggregator. Set the corresponding key; leave others blank.
#   Upload-Post:  https://www.upload-post.com/
#   Postproxy:    https://postproxy.dev/
#   Bundle.social: https://bundle.social/
UPLOAD_POST_API_KEY=
POSTPROXY_API_KEY=
BUNDLE_SOCIAL_API_KEY=

# --- Native platform fallbacks (free, no CC) --------------------------------
# Used when the aggregator's free quota is exhausted. All free dev accounts.

# YouTube Data API v3 — https://console.cloud.google.com/ (no billing setup)
# Place OAuth client_secret JSON at config/youtube_client_secret.json
YOUTUBE_CHANNEL_ID=

# Meta Graph API (Facebook Page + Instagram + Threads) — https://developers.facebook.com/
META_PAGE_ID=
META_IG_BUSINESS_ACCOUNT_ID=
META_ACCESS_TOKEN=
THREADS_USER_ID=

# TikTok Content Posting API — https://developers.tiktok.com/ (sandbox first)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- Telegram notifications (free) ------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Dashboard (optional — web UI for monitoring + triggering) ---------------
# Leave both empty for open access (no password).
# Set them to enable HTTP Basic Auth on every dashboard route.
DASHBOARD_USER=
DASHBOARD_PASSWORD=
# Port / host for the dashboard server (defaults: 8080 / 0.0.0.0)
DASHBOARD_PORT=
DASHBOARD_HOST=

# --- Paths / behaviour ------------------------------------------------------
# Absolute path to project root (auto-detected if empty)
PROJECT_ROOT=
# Monthly USD spend cap on PAID video generations (free-tier runs don't count)
BUDGET_CAP=5
# Path to faster-whisper model size: tiny | base | small | medium
WHISPER_MODEL=base

# --- RunPod VPS Start/Stop Automation (Optional) -----------------------------
RUNPOD_API_KEY=
RUNPOD_POD_ID=

# --- Replicate API for MMAudio V2A SFX (Optional) -----------------------------
REPLICATE_API_TOKEN=



